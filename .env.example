DATABASE_URL="postgresql://user:password@localhost:5432/multisend?schema=public"

# Session JWT signing secret (generate with: openssl rand -base64 32)
SESSION_SECRET="replace-with-a-strong-random-secret"

# SEP-10-style login: server signing keypair and home domain identifying this app
SEP10_SERVER_SECRET="S...replace-with-a-dedicated-server-signing-key"
NEXT_PUBLIC_HOME_DOMAIN="multisend.app"

# Default network shown on first load: TESTNET or PUBLIC
NEXT_PUBLIC_DEFAULT_NETWORK="TESTNET"

# Required only for Mainnet: SDF has no free official Mainnet RPC.
# Point this at a provider (see https://stellarbeat.io for validator/RPC options).
NEXT_PUBLIC_MAINNET_RPC_URL=""
