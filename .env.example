DATABASE_URL="postgresql://user:password@localhost:5432/sendall?schema=public"

# Session JWT + SEP-53 login challenge signing secret (generate with: openssl rand -base64 32)
SESSION_SECRET="replace-with-a-strong-random-secret"

# Home domain embedded in the SEP-53 sign-in message, binds it to this app
NEXT_PUBLIC_HOME_DOMAIN="app.sendall.xyz"

# Default network shown on first load: TESTNET or PUBLIC
NEXT_PUBLIC_DEFAULT_NETWORK="TESTNET" # or "PUBLIC" (Mainnet); blank means Testnet

# Required only for Mainnet: SDF has no free official Mainnet RPC, but
# third parties do — see https://developers.stellar.org/docs/data/apis/rpc/providers
# (mainnet.sorobanrpc.com below is one of the free public ones listed there;
# swap for a dedicated/paid provider for anything beyond light use).
NEXT_PUBLIC_MAINNET_RPC_URL="https://mainnet.sorobanrpc.com"

# Channel engine service accounts (server only, never NEXT_PUBLIC).
# Encrypts channel account secrets stored in the database.
# Generate: openssl rand -base64 32
SERVICE_KEY_ENCRYPTION_KEY=""
# Sponsor / fee account (M) per network. Testnet: `npm run bootstrap:testnet`
# creates and funds one. Mainnet: fund by hand, see the Mainnet runbook.
SPONSOR_SECRET_TESTNET=""
SPONSOR_SECRET_PUBLIC=""
# Channel accounts kept per network (one per 100-recipient chunk in flight).
CHANNEL_POOL_SIZE="20"
# Send engine: "channels" (default; one signature, parallel chunks) or
# "legacy" (Phase 1 sequential sender, kept as baseline and fallback).
NEXT_PUBLIC_SEND_ENGINE="channels"
# Optional per-network fee cap in stroops per operation (default 10000).
FEE_CAP_STROOPS_PER_OP_PUBLIC=""
