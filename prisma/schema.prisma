// Sendall data model — classic Stellar bulk payments (no Soroban).
// See /Users/caner/.claude/plans/instawards-statement-of-work-sow-goofy-hopcroft.md

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Network {
  TESTNET
  PUBLIC
}

enum BatchStatus {
  DRAFT
  VALIDATING
  VALIDATED
  CHECKING
  READY
  SUBMITTING
  PARTIAL_FAILURE
  COMPLETED
  FAILED
}

enum LineItemStatus {
  PENDING
  VALIDATION_FAILED
  CHECK_FAILED
  READY
  IN_TRANSACTION
  SUCCESS
  FAILED
}

enum AttemptStatus {
  BUILT
  SIGNED
  SUBMITTED
  SUCCESS
  FAILED
}

model RefreshToken {
  id             String    @id @default(cuid())
  ownerPublicKey String
  tokenHash      String    @unique
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?

  @@index([ownerPublicKey])
}

model Batch {
  id             String      @id @default(cuid())
  ownerPublicKey String
  network        Network
  assetCode      String? // null = native XLM
  assetIssuer    String?
  sourceAccount  String
  status         BatchStatus @default(DRAFT)
  csvFileName    String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  recipients Recipient[]
  attempts   PaymentAttempt[]

  @@index([ownerPublicKey])
}

model Recipient {
  id       String @id @default(cuid())
  batchId  String
  batch    Batch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowIndex Int

  destination String
  amount      Decimal
  memo        String?

  addressValid     Boolean @default(false)
  isDuplicate      Boolean @default(false)
  accountExists    Boolean?
  hasTrustline     Boolean?
  trustlineLimitOk Boolean?

  status       LineItemStatus @default(PENDING)
  errorMessage String?

  attemptItems PaymentAttemptItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([batchId])
}

model PaymentAttempt {
  id             String        @id @default(cuid())
  batchId        String
  batch          Batch         @relation(fields: [batchId], references: [id], onDelete: Cascade)
  chunkIndex     Int
  sequenceNumber String?
  operationCount Int
  status         AttemptStatus @default(BUILT)
  txHash         String?
  xdrEnvelope    String?       @db.Text
  resultXdr      String?       @db.Text
  errorCode      String?
  submittedAt    DateTime?
  createdAt      DateTime      @default(now())

  items PaymentAttemptItem[]

  @@index([batchId])
}

model PaymentAttemptItem {
  id             String         @id @default(cuid())
  attemptId      String
  attempt        PaymentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  recipientId    String
  recipient      Recipient      @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  operationIndex Int
  resultCode     String?
  status         AttemptStatus  @default(BUILT)

  @@index([attemptId])
  @@index([recipientId])
}
