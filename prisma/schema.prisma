// Sendall data model — classic Stellar bulk payments (no Soroban).
// See /Users/caner/.claude/plans/instawards-statement-of-work-sow-goofy-hopcroft.md

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Network {
  TESTNET
  PUBLIC
}

enum BatchStatus {
  DRAFT
  VALIDATING
  VALIDATED
  CHECKING
  READY
  SUBMITTING
  PARTIAL_FAILURE
  COMPLETED
  FAILED
}

enum LineItemStatus {
  PENDING
  VALIDATION_FAILED
  CHECK_FAILED
  READY
  IN_TRANSACTION
  SUCCESS
  FAILED
}

enum AttemptStatus {
  BUILT
  SIGNED
  SUBMITTED
  SUCCESS
  FAILED
}

// Phase 2: channel engine, claimable balances. See docs/prd.md section 3.

enum BatchKind {
  PAYMENT
  CLAIMABLE_BALANCE
}

enum DeliveryMethod {
  PAYMENT
  CREATE_ACCOUNT
  CLAIMABLE_BALANCE
}

enum ClaimStatus {
  UNCLAIMED
  CLAIMED
  RECLAIMED
}

enum ChannelStatus {
  AVAILABLE
  RESERVED
  SUBMITTED
  AWAITING_CONFIRMATION
  // Sequence moved unexpectedly or a submission is in an unknown state.
  // Never handed out again until reconciled.
  QUARANTINED
}

enum RunPurpose {
  SEND
  RECLAIM
  REAUTHORIZE
  CLEANUP
}

enum RunStatus {
  CREATED
  PAYMENTS_PREPARED
  AWAITING_USER_SIGNATURE
  SETUP_SUBMITTED
  SETUP_CONFIRMED
  PAYMENTS_SUBMITTING
  COMPLETED
  PARTIALLY_FAILED
  FAILED
  EXPIRED
}

enum ChannelTxStatus {
  PREPARED
  SUBMITTING
  SUCCESS
  FAILED
  // Reached the ledger and failed: its preAuthTx signer is consumed, so it
  // can only be retried with a new user authorization.
  REAUTHORIZATION_REQUIRED
  // Time bounds passed without being applied. Its signer may still sit on
  // the sender until a cleanup run removes it.
  EXPIRED
}

model RefreshToken {
  id             String    @id @default(cuid())
  ownerPublicKey String
  tokenHash      String    @unique
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?

  @@index([ownerPublicKey])
}

model Batch {
  id             String      @id @default(cuid())
  // Null until a wallet claims this batch (see `claimedAt`) — batches can be
  // drafted anonymously, scoped instead by `anonId`, before any wallet signs in.
  ownerPublicKey String?
  // Anonymous-session identifier a wallet-less visitor is scoped by. Set at
  // creation when there's no authenticated session; cleared (left as-is,
  // ownerPublicKey takes over) once claimed.
  anonId         String?
  claimedAt      DateTime?
  network        Network
  assetCode      String? // null = native XLM
  assetIssuer    String?
  // Null until claimed — this is the wallet that will sign, so it can't be
  // known before a wallet connects.
  sourceAccount  String?
  status         BatchStatus @default(DRAFT)
  csvFileName    String?
  kind           BatchKind   @default(PAYMENT)
  // Claimable balance batches only: the recipient can claim before this
  // time, the sender can reclaim after it. Fixed when a run is prepared,
  // from claimWindowDays, so the window counts from sending.
  claimExpiresAt  DateTime?
  claimWindowDays Int?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  recipients Recipient[]
  attempts   PaymentAttempt[]
  runs       DistributionRun[]

  @@index([ownerPublicKey])
  @@index([anonId])
}

model Recipient {
  id       String @id @default(cuid())
  batchId  String
  batch    Batch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowIndex Int

  destination String
  amount      Decimal
  memo        String?

  addressValid     Boolean @default(false)
  isDuplicate      Boolean @default(false)
  accountExists    Boolean?
  currentBalance   Decimal?
  hasTrustline     Boolean?
  trustlineLimitOk Boolean?

  status       LineItemStatus @default(PENDING)
  errorMessage String?

  deliveryMethod     DeliveryMethod?
  claimableBalanceId String?
  claimStatus        ClaimStatus?
  claimTxHash        String?
  claimedAt          DateTime?

  attemptItems PaymentAttemptItem[]
  channelItems ChannelTransactionItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([batchId])
}

model PaymentAttempt {
  id             String        @id @default(cuid())
  batchId        String
  batch          Batch         @relation(fields: [batchId], references: [id], onDelete: Cascade)
  chunkIndex     Int
  sequenceNumber String?
  operationCount Int
  // false when this attempt is authorized by a preAuthTx signer the
  // previous chunk installed on-chain (see txBuilder.ts) — it must be
  // submitted exactly as built, with no wallet signature requested.
  requiresSignature Boolean       @default(true)
  status         AttemptStatus @default(BUILT)
  txHash         String?
  xdrEnvelope    String?       @db.Text
  resultXdr      String?       @db.Text
  errorCode      String?
  submittedAt    DateTime?
  createdAt      DateTime      @default(now())

  items PaymentAttemptItem[]

  @@index([batchId])
}

model PaymentAttemptItem {
  id             String         @id @default(cuid())
  attemptId      String
  attempt        PaymentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  recipientId    String
  recipient      Recipient      @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  operationIndex Int
  resultCode     String?
  status         AttemptStatus  @default(BUILT)

  @@index([attemptId])
  @@index([recipientId])
}

// Always owned by an authenticated wallet — unlike Batch, there's no
// anon/claim flow here, so ownerPublicKey is required from creation.
model AddressList {
  id             String   @id @default(cuid())
  ownerPublicKey String
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  entries AddressListEntry[]

  @@index([ownerPublicKey])
}

model AddressListEntry {
  id      String      @id @default(cuid())
  listId  String
  list    AddressList @relation(fields: [listId], references: [id], onDelete: Cascade)

  rowIndex     Int
  name         String
  address      String
  addressValid Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([listId])
}

// Sendall-owned transaction source accounts. They only supply sequence
// numbers; every operation they carry is sourced from the sender and
// authorized by a one-time preAuthTx signer. Secrets are AES-GCM
// encrypted (lib/crypto/serviceKeys).
model ChannelAccount {
  id               String        @id @default(cuid())
  network          Network
  publicKey        String        @unique
  encryptedSecret  String        @db.Text
  status           ChannelStatus @default(AVAILABLE)
  // The sequence number the reserved transaction was built with. If the
  // account's sequence moves anywhere else, the authorization is void.
  expectedSequence String?
  runId            String?
  transactionId    String?
  lockedAt         DateTime?
  expiresAt        DateTime?
  lastError        String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([network, status])
}

// One authorization round: a setup transaction the sender signs once,
// followed by the channel transactions it pre-authorizes.
model DistributionRun {
  id             String     @id @default(cuid())
  batchId        String
  batch          Batch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  purpose        RunPurpose @default(SEND)
  idempotencyKey String     @unique
  status         RunStatus  @default(CREATED)
  network        Network
  sourceAccount  String
  sponsorAccount String
  preAuthWeight  Int?
  parentRunId    String?
  // advanceRun lease: only one worker drives a run at a time.
  leaseOwner     String?
  leaseUntil     DateTime?

  setupXdr         String?   @db.Text
  setupHash        String?   @unique
  setupSignedXdr   String?   @db.Text
  setupFeeBumpXdr  String?   @db.Text
  setupTxHash      String?
  setupMaxTime     DateTime?
  setupSubmittedAt DateTime?
  setupConfirmedAt DateTime?

  // Benchmark clock: from the user's signature to the last confirmation.
  signedAt     DateTime?
  completedAt  DateTime?
  errorCode    String?
  errorMessage String?

  transactions ChannelTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([batchId])
  @@index([status])
}

model ChannelTransaction {
  id               String          @id @default(cuid())
  runId            String
  run              DistributionRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  chunkIndex       Int
  channelPublicKey String
  channelSequence  String
  // Exact XDR the setup pre-authorized. Never rebuilt.
  unsignedInnerXdr String          @db.Text
  transactionHash  String          @unique
  feeBumpXdr       String?         @db.Text
  stellarTxHash    String?
  status           ChannelTxStatus @default(PREPARED)
  attemptCount     Int             @default(0)
  errorCode        String?
  resultXdr        String?         @db.Text
  maxTime          DateTime
  createdAt        DateTime        @default(now())
  submittedAt      DateTime?
  confirmedAt      DateTime?

  items ChannelTransactionItem[]

  @@unique([runId, chunkIndex])
}

model ChannelTransactionItem {
  id                 String             @id @default(cuid())
  transactionId      String
  transaction        ChannelTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  recipientId        String
  recipient          Recipient          @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  operationIndex     Int
  deliveryMethod     DeliveryMethod
  status             ChannelTxStatus    @default(PREPARED)
  resultCode         String?
  claimableBalanceId String?

  @@index([transactionId])
  @@index([recipientId])
}
